# Factorio Modeler - Service Implementation

## Overview
The Services module implements business logic for recipe parsing, machine analysis, and throughput optimization.

## Services

### RecipeParser Service
```csharp
public class RecipeParser
{
    private const string DATA_PATH = "factorio_recipes_and_machines.json";
    
    public List<Recipe> ParseRecipes(string filePath)
    {
        var json = File.ReadAllText(filePath);
        return JsonConvert.DeserializeObject<List<Recipe>>(json);
    }
    
    public ValidationResult ValidateRecipe(Recipe recipe)
    {
        if (recipe.OutputQty <= 0 || recipe.CraftingTime <= 0)
        {
            return new ValidationResult { IsValid = false, Error = "Invalid values" };
        }
        return new ValidationResult { IsValid = true };
    }
    
    public Dictionary<string, int> ExtractResources(int[][] resourceList)
    {
        var map = resourceList.SelectMany(r => r)
            .GroupBy(r => r.ItemId)
            .ToDictionary(g => g.Key, g => g.Sum(r => r.Amount));
        return map;
    }
}
```

### MachineAnalyzer Service
```csharp
public class MachineAnalyzer
{
    public double CalculateThroughput(int outputQty, double craftingTime, int machineLevel)
    {
        return (outputQty / craftingTime) * MachineRegistry.GetSpeedMultiplier(machineLevel) * 60;
    }
    
    public ValidationResult ValidateThroughput(double actual, double expected)
    {
        var tolerance = 0.001;
        return new ValidationResult
        {
            IsValid = Math.Abs(actual - expected) <= tolerance,
            Error = Math.Abs(actual - expected),
            Accuracy = (1.0 - (Math.Abs(actual - expected) / expected)) * 100
        };
    }
    
    public string GetMachineCategory(string machineId)
    {
        return machineId switch
        {
            "assembling-machine-2" => "industrial",
            "belt" => "belt",
            "buffer" => "storage",
            "circuit" => "circuit",
            "crafting-module" => "module",
            "tank" => "tank",
            _ => "unknown"
        };
    }
}
```

### BeltFlowAnalyzer Service
```csharp
public class BeltFlowAnalyzer
{
    public double CalculateFlow(int itemsPerSecond, double beltSpeed)
    {
        return itemsPerSecond * beltSpeed;
    }
    
    public ValidationResult ValidateFlow(double flow, double throughput)
    {
        return new ValidationResult 
        { 
            IsValid = flow >= throughput, 
            Flow = flow, 
            Throughput = throughput 
        };
    }
}
```

### CircuitSolver Service
```csharp
public class CircuitSolver
{
    public CircuitOutput SolveCircuit(int[] wireValues, double[] wireOutputs)
    {
        return new CircuitOutput
        {
            ValidCircuit = wireValues.Length == wireOutputs.Length,
            CircuitValue = CalculateCircuitValue(wireValues, wireOutputs),
            CircuitOutput = GetOutput(wireOutputs)
        };
    }
    
    private double CalculateCircuitValue(int[] values, double[] outputs)
    {
        return values.Sum() - outputs.Sum();
    }
    
    private string GetOutput(double[] outputs)
    {
        return outputs.Length > 0 ? $"[{string.Join(", ", outputs)}]" : "[]";
    }
}
```

### PowerAnalyzer Service
```csharp
public class PowerAnalyzer
{
    private const double BASE_POWER = 1.5; // MW
    
    public double CalculatePowerUsage(int machineCount, double efficiency)
    {
        return machineCount * BASE_POWER * (1.0 - efficiency);
    }
    
    public ValidationResult ValidatePower(double actual, double expected)
    {
        return new ValidationResult 
        { 
            IsValid = Math.Abs(actual - expected) <= 0.001,
            Actual = actual, 
            Expected = expected 
        };
    }
}
```

### ThroughputCalculator Service
```csharp
public class ThroughputCalculator
{
    public (int id, string entity, string name, double throughput, List<int> tier, string[][] machines, string recipe, List<bool> active)
        Calculate(int id, string entity, string name, int outputQty, double craftingTime, int tier)
    {
        var throughput = (outputQty / craftingTime) * MachineRegistry.GetSpeedMultiplier(tier) * 60;
        return (id, entity, name, throughput, [tier], null, null, new List<bool>());
    }
}
```

