### ProductionChainAnalyzer Service
```csharp
public class ProductionChainAnalyzer
{
    public List<ProductionChain> AnalyzeChains(List<ProductionEntity> entities)
    {
        return entities.Select(e => new ProductionChain
        {
            Id = e.Id,
            EntityName = e.EntityName,
            Recipes = new List<string> { e.Recipe }
        }).ToList();
    }
    
    public ValidationResult AnalyzeChain(ProductionEntity entity)
    {
        return new ValidationResult { IsValid = true, Chain = entity };
    }
}
```

### ThroughputValidation Service
```csharp
public class ThroughputValidation
{
    public bool ValidateFormula(double outputQty, double craftingTime, double machineSpeed, double expected)
    {
        double actual = (outputQty / craftingTime) * machineSpeed * 60;
        return Math.Abs(actual - expected) <= 0.001;
    }
    
    public ValidationResult GetValidation(double outputQty, double craftingTime, double machineSpeed)
    {
        var actual = (outputQty / craftingTime) * machineSpeed * 60;
        return ValidationResult
        {
            IsValid = actual > 0,
            Actual = actual,
            Expected = expected,
            Error = Math.Abs(actual - expected)
        };
    }
}
```

### Calculator Implementation
```csharp
public class ThroughputCalculator
{
    private const double TOLERANCE = 0.001;
    
    public double CalculateThroughput(Recipe recipe, double machineSpeed)
    {
        return (recipe.OutputQty / recipe.CraftingTime) * machineSpeed * 60;
    }
    
    public ValidationResult ValidateResult(double calculated, double expected)
    {
        return new ValidationResult
        {
            IsValid = Math.Abs(calculated - expected) <= TOLERANCE,
            Calculated = calculated,
            Expected = expected,
            Tolerance = TOLERANCE
        };
    }
    
    public double GetAccuracyTolerance() => TOLERANCE;
}

public class Machine
{
    public int Level { get; set; }
    public double SpeedMultiplier => Level switch
    {
        1 => 0.67,
        2 => 1.0,
        3 => 1.5,
        _ => 1.0
    };
}
```

### ThroughputCalculator Implementation
```csharp
public class Calculator
{
    private const double TOLERANCE = 0.001;
    
    public static double CalculateThroughput(Recipe recipe, Machine machine)
    {
        return (recipe.OutputQty / recipe.CraftingTime) * machine.SpeedMultiplier * 60;
    }
    
    public static ValidationResult Validate(double actual, double expected)
    {
        return new ValidationResult 
        { 
            IsValid = Math.Abs(actual - expected) <= TOLERANCE,
            Actual = actual,
            Expected = expected
        };
    }
}

public class Machine
{
    public int Level { get; set; }
    public double SpeedMultiplier
    {
        get
        {
            return Level switch
            {
                1 => 0.67,
                2 => 1.0,
                3 => 1.5,
                _ => throw new ArgumentException("Invalid machine level")
            };
        }
    }
}
```

### ThroughputCalculatorTests
```csharp
public class ThroughputCalculatorTests
{
    private readonly ThroughputCalculator _calculator = new();
    
    [Fact]
    public void AdvancedCircuit_Throughput_Expected()
    {
        var recipe = new Recipe { OutputQty = 1, CraftingTime = 6 };
        var machine = new Machine { Level = 3 };
        
        var result = _calculator.CalculateThroughput(recipe, machine);
        var tolerance = _calculator.GetAccuracyTolerance();
        
        Assert.InRange(result, 15.0 - tolerance, 15.0 + tolerance);
        Assert.InRange(_calculator.GetAccuracyTolerance(), 0.001, 0.002);
    }
    
    [Fact]
    public void ExpressSplitter_Throughput_Expected()
    {
        var expression = new Recipe { OutputQty = 1, CraftingTime = 2.5 };
        var machine = new Machine { Level = 3 };
        
        var result = _calculator.CalculateThroughput(expression, machine);
        var tolerance = _calculator.GetAccuracyTolerance();
        
        Assert.InRange(result, 36.0 - tolerance, 36.0 + tolerance);
    }
    
    [Fact]
    public void ValidateResult_WithinTolerance()
    {
        var result = _calculator.ValidateResult(15.0, 15.0);
        Assert.True(result.IsValid);
        Assert.InRange(result.Error, 0.0, 0.001);
    }
}
```

