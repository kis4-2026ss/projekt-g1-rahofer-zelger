### Graph Manager
```csharp
public class GraphManager
{
    private const string RECIPE = "advanced-circuit";
    
    public GraphNode CreateNode(int id, string[] machines, string recipeName, 
                               double throughput, string[] active)
    {
        return new GraphNode
        {
            Id = id,
            Machines = machines,
            RecipeName = recipeName,
            Throughput = throughput,
            Active = active
        };
    }
    
    public GraphNode GetNodeByLevel(int level)
    {
        return new GraphNode
        {
            Id = level,
            Machines = GetMachinesByLevel(level),
            RecipeName = RECIPE,
            Throughput = GetThroughputByLevel(level),
            Active = GetActiveByLevel(level)
        };
    }
    
    private string[] GetMachinesByLevel(int level) => new string[] { level.ToString(), "advanced-circuit" };
    private double GetThroughputByLevel(int level) => (1/6) * 1.5 * 60;
    private string[] GetActiveByLevel(int level) => new[] { "true" };
}
```

